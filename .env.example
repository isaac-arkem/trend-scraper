APIFY_TOKEN=

SUPABASE_URL=
SUPABASE_PUBLIC_KEY=
SUPABASE_SECRET_KEY=

OPENAI_API_KEY=

# Where media and run archives are written. Defaults to wasabi when unset.
# MinIO lives on the office NAS and went unreachable twice in one day, so new
# runs go off-site. Set to minio to write locally again — both are
# S3-compatible, and the object paths are identical either way.
# Jenkins sets TRIAGE_OBJECT_STORE; either name selects the backend.
TRIAGE_OBJECT_STORE=wasabi

WASABI_ENDPOINT_URL=https://s3.eu-central-2.wasabisys.com
WASABI_ACCESS_KEY=
WASABI_SECRET_KEY=
# Optional — derived from the endpoint host when unset. Wasabi rejects a write
# signed for the wrong region.
WASABI_REGION=
# Media bucket. Run archives go to a second bucket named by TRENDS_BUCKET
# (default: trends). If the key can only reach ONE bucket, name it here and both
# land inside it under a prefix each — the keys stay byte-identical either way,
# so the arrangement can be changed later without re-pathing anything.
WASABI_BUCKET=social-intel

# Only read when OBJECT_STORE=minio.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=social-intel
